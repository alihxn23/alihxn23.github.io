---
import profile from '../data/profile.json';

const { social } = profile;

const platformIcons: Record<string, string> = {
  GitHub: '[ gh ]',
  LinkedIn: '[ in ]',
  Discord: '[ dc ]',
};
---

<section id="contact" class="contact" aria-label="Contact and social links">
  <div class="section-header">
    <span class="section-header__prefix">~/</span>
    <h2 class="section-header__title">contact</h2>
    <span class="section-header__line"></span>
  </div>

  <div class="contact__terminal terminal-window">
    <div class="terminal-window__title-bar">
      <div class="terminal-window__dots">
        <span class="terminal-window__dot terminal-window__dot--red"></span>
        <span class="terminal-window__dot terminal-window__dot--yellow"></span>
        <span class="terminal-window__dot terminal-window__dot--green"></span>
      </div>
      <span class="terminal-window__title">visitor@hxn.sh:~/contact</span>
    </div>
    <div class="terminal-window__body">
      <p class="contact__prompt terminal-output">
        <span class="text-green">$</span> cat ./social-links.txt
      </p>
      <ul class="contact__list">
        {social.map((link) => (
          <li class="contact__item">
            <span class="contact__icon text-cyan">{platformIcons[link.platform] || `[ ${link.platform.toLowerCase()} ]`}</span>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="terminal-link contact__link"
              aria-label={link.label}
            >
              {link.platform} <span class="contact__url text-amber">→ {link.url}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="contact__footer terminal-output">
        <span class="text-green">$</span> <span class="cursor-blink"></span>
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 4rem 1rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .contact__prompt {
    margin-bottom: 1rem;
  }

  .contact__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
  }

  .contact__icon {
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .contact__url {
    font-size: 0.8125rem;
  }

  .contact__footer {
    margin-top: 0.5rem;
  }

  @media (max-width: 480px) {
    .contact {
      padding: 3rem 1rem;
    }

    .contact__link {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .contact__url {
      font-size: 0.75rem;
    }
  }
</style>
