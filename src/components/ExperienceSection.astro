---
import profile from '../data/profile.json';

const MONTH_NAMES = [
  'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
];

function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'Present';
  const [year, month] = dateStr.split('-');
  const monthIndex = parseInt(month, 10) - 1;
  return `${MONTH_NAMES[monthIndex]} ${year}`;
}

function parseDateValue(dateStr: string | null): number {
  if (!dateStr) return Infinity; // null endDate means current/present, sorts first
  const [year, month] = dateStr.split('-').map(Number);
  return year * 12 + month;
}

const experiences = [...profile.experience].sort(
  (a, b) => parseDateValue(b.startDate) - parseDateValue(a.startDate)
);
---

<section id="experience" class="experience" aria-label="Professional experience">
  <div class="section-header">
    <span class="section-header__prefix">~/</span>
    <h2 class="section-header__title">experience</h2>
    <span class="section-header__line"></span>
  </div>

  <div class="experience__list">
    {experiences.map((entry) => (
      <div class="experience__entry terminal-window">
        <div class="terminal-window__title-bar">
          <div class="terminal-window__dots">
            <span class="terminal-window__dot terminal-window__dot--red"></span>
            <span class="terminal-window__dot terminal-window__dot--yellow"></span>
            <span class="terminal-window__dot terminal-window__dot--green"></span>
          </div>
          <span class="terminal-window__title">{entry.company}</span>
        </div>
        <div class="terminal-window__body">
          <div class="experience__header">
            <h3 class="experience__title">{entry.title}</h3>
            <span class="experience__company text-cyan">@ {entry.company}</span>
          </div>
          <p class="experience__date">
            <span class="text-amber">{formatDate(entry.startDate)} - {formatDate(entry.endDate)}</span>
          </p>
          <p class="experience__description">{entry.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .experience {
    padding: 4rem 1rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .experience__list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .experience__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .experience__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--terminal-green);
    text-shadow: var(--glow-green);
  }

  .experience__company {
    font-size: 0.875rem;
  }

  .experience__date {
    font-size: 0.8125rem;
    margin-bottom: 0.75rem;
  }

  .experience__description {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .experience {
      padding: 3rem 1rem;
    }

    .experience__title {
      font-size: 1rem;
    }

    .experience__header {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
