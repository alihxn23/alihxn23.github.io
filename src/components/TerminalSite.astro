---
/**
 * TerminalSite.astro - The entire site as one interactive terminal session
 *
 * The page is a single full-screen terminal window. On load, the "about" info
 * is pre-rendered as if `cat about.txt` was already run. The user types commands
 * (or clicks suggestion buttons) to output different sections inline.
 *
 * Content is rendered server-side in hidden containers for SEO, then cloned
 * into the terminal output when the corresponding command is executed.
 */
import profile from '../data/profile.json';
import { COMMANDS } from '../scripts/terminal-nav.ts';

const { name, role, company, tagline, social } = profile;
const experiences = profile.experience;
const { skills, certifications, education } = profile;

const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'Present';
  const [year, month] = dateStr.split('-');
  return `${MONTH_NAMES[parseInt(month, 10) - 1]} ${year}`;
}

// Commands to show as suggestion buttons (exclude "about" since it's pre-rendered)
const suggestionCommands = COMMANDS.filter(cmd => cmd.name !== "about");
---

<div class="site-terminal">
  <div class="site-terminal__window terminal-window">
    <div class="terminal-window__title-bar">
      <div class="terminal-window__dots">
        <span class="terminal-window__dot terminal-window__dot--red"></span>
        <span class="terminal-window__dot terminal-window__dot--yellow"></span>
        <span class="terminal-window__dot terminal-window__dot--green"></span>
      </div>
      <span class="terminal-window__title">visitor@hxn.sh:~</span>
    </div>
    <div class="terminal-window__body site-terminal__body" id="terminal-body">
      <!-- Pre-rendered initial output (the "about" section) -->
      <div class="terminal-line terminal-line--cmd">
        <span class="text-green">visitor@hxn.sh:~$</span> cat about.txt
      </div>
      <div class="terminal-line terminal-line--output terminal-about">
        <pre class="terminal-about__ascii" aria-hidden="true">{`
███╗   ███╗██╗   ██╗██╗  ██╗ █████╗ ███╗   ███╗███╗   ███╗ █████╗ ██████╗ 
████╗ ████║██║   ██║██║  ██║██╔══██╗████╗ ████║████╗ ████║██╔══██╗██╔══██╗
██╔████╔██║██║   ██║███████║███████║██╔████╔██║██╔████╔██║███████║██║  ██║
██║╚██╔╝██║██║   ██║██╔══██║██╔══██║██║╚██╔╝██║██║╚██╔╝██║██╔══██║██║  ██║
██║ ╚═╝ ██║╚██████╔╝██║  ██║██║  ██║██║ ╚═╝ ██║██║ ╚═╝ ██║██║  ██║██████╔╝
╚═╝     ╚═╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝     ╚═╝╚═╝     ╚═╝╚═╝  ╚═╝╚═════╝ 

██╗  ██╗ █████╗ ███████╗ █████╗ ███╗   ██╗
██║  ██║██╔══██╗██╔════╝██╔══██╗████╗  ██║
███████║███████║███████╗ ███████║██╔██╗ ██║
██╔══██║██╔══██║╚════██║██╔══██║██║╚██╗██║
██║  ██║██║  ██║███████║██║  ██║██║ ╚████║
╚═╝  ╚═╝╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝`}</pre>
        <span class="sr-only">{name}</span>
        <p class="terminal-about__role">
          <span class="text-cyan">{role}</span> <span class="text-amber">@</span> <span class="text-green">{company}</span>
        </p>
        <p class="terminal-about__tagline">{tagline}</p>
        <div class="terminal-about__links">
          {social.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="terminal-link" aria-label={s.label}>
              [{s.platform.toLowerCase()}]
            </a>
          ))}
        </div>
      </div>

      <!-- Terminal output area where command results appear -->
      <div id="terminal-output"></div>

      <!-- Input prompt (always at bottom of content) -->
      <div class="terminal-line terminal-line--input" id="terminal-input-line">
        <span class="terminal-input__prompt text-green" aria-hidden="true">visitor@hxn.sh:~$</span>
        <div class="terminal-input__wrapper">
          <input
            id="terminal-input"
            class="terminal-input__field"
            type="text"
            aria-label="Terminal command input. Type help for available commands."
            autocomplete="off"
            spellcheck="false"
          />
          <span id="terminal-hint" class="terminal-input__hint" aria-hidden="true"></span>
          <span id="terminal-autocomplete" class="terminal-input__autocomplete" aria-hidden="true"></span>
          <span class="terminal-input__cursor" aria-hidden="true"></span>
        </div>
      </div>

      <!-- Suggestion buttons -->
      <div class="terminal-suggestions" aria-label="Available commands">
        {suggestionCommands.map((cmd) => (
          <button
            class={`terminal-suggestions__btn${["showall", "help", "clear"].includes(cmd.name) ? " terminal-suggestions__btn--secondary" : ""}`}
            data-command={cmd.name}
            type="button"
            aria-label={`Run command: ${cmd.name}`}
          >
            <span class="terminal-suggestions__prefix" aria-hidden="true">&gt;</span>
            {cmd.name}
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<!-- Hidden section content for SEO + cloning into terminal output -->
<div id="section-data" style="display:none;">
  <div id="tpl-experience">
    <div class="terminal-section">
      <div class="terminal-section__header">~/experience</div>
      {experiences.map((entry) => (
        <div class="terminal-entry">
          <div class="terminal-entry__title">
            <span class="text-green">{entry.title}</span>
            <span class="text-cyan"> @ {entry.company}</span>
          </div>
          <div class="terminal-entry__meta text-amber">{formatDate(entry.startDate)} — {formatDate(entry.endDate)}</div>
          <div class="terminal-entry__body">{entry.description}</div>
        </div>
      ))}
    </div>
  </div>

  <div id="tpl-skills">
    <div class="terminal-section">
      <div class="terminal-section__header">~/skills</div>
      {skills.map((group) => (
        <div class="terminal-entry">
          <div class="terminal-entry__title text-cyan">{group.category}</div>
          <div class="terminal-entry__tags">
            {group.items.map((item) => (
              <span class="terminal-tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div id="tpl-certs">
    <div class="terminal-section">
      <div class="terminal-section__header">~/certifications</div>
      {certifications.map((group) => (
        <div class="terminal-entry">
          <div class="terminal-entry__title text-cyan">{group.provider}</div>
          <div class="terminal-entry__tags">
            {group.certifications.map((cert) => (
              <span class="terminal-tag">{cert.code ? `${cert.name} (${cert.code})` : cert.name}</span>
            ))}
          </div>
        </div>
      ))}
      <div class="terminal-entry terminal-entry--inline">
        <span class="text-amber">→</span>
        <a href="https://credly.hxn.sh" target="_blank" rel="noopener noreferrer" class="terminal-link">View all badges on Credly</a>
      </div>
    </div>
  </div>

  <div id="tpl-education">
    <div class="terminal-section">
      <div class="terminal-section__header">~/education</div>
      {education.map((edu) => (
        <div class="terminal-entry">
          <div class="terminal-entry__title text-green">{edu.degree}</div>
          <div class="terminal-entry__meta">
            <span class="text-cyan">@ {edu.institution}</span>
            {edu.gpa && <span class="text-amber"> — GPA: {edu.gpa}</span>}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div id="tpl-contact">
    <div class="terminal-section">
      <div class="terminal-section__header">~/contact</div>
      {social.map((s) => (
        <div class="terminal-entry terminal-entry--inline">
          <span class="text-cyan">[{s.platform.toLowerCase()}]</span>
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="terminal-link">{s.url}</a>
        </div>
      ))}
    </div>
  </div>
</div>

<noscript>
  <style>
    #section-data {
      display: block !important;
    }
    .terminal-line--input,
    .terminal-suggestions {
      display: none !important;
    }
  </style>
</noscript>

<script>
  import { initTerminalSite } from '../scripts/terminal-site.ts';
  document.addEventListener('DOMContentLoaded', initTerminalSite);
</script>


<style>
  .site-terminal {
    min-height: 100vh;
    display: flex;
    align-items: stretch;
    justify-content: center;
    padding: 1rem;
  }

  .site-terminal__window {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 2rem);
    /* Semi-transparent so the lightning grid shows through. */
    background-color: rgba(18, 18, 26, 0.62);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .site-terminal__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow-y: auto;
    padding: var(--terminal-padding);
  }

  /* Terminal lines */
  .terminal-line {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .terminal-line--cmd {
    color: var(--text-primary);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal-line--output {
    color: var(--text-secondary);
    padding-left: 0;
  }

  .terminal-line--input {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  /* About section (pre-rendered) */
  .terminal-about__ascii {
    color: var(--terminal-green);
    font-size: 0.65rem;
    line-height: 1.2;
    text-shadow: var(--glow-green);
    overflow-x: auto;
    white-space: pre;
    margin-bottom: 0.75rem;
  }

  .terminal-about__role {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .terminal-about__tagline {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .terminal-about__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  /* Input area */
  .terminal-input__prompt {
    white-space: nowrap;
    font-size: 0.875rem;
  }

  .terminal-input__wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .terminal-input__field {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    caret-color: transparent;
  }

  .terminal-input__cursor {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0.55em;
    height: 1.1em;
    background: var(--terminal-green);
    animation: cursor-blink 1s step-end infinite;
    pointer-events: none;
  }

  .terminal-input__hint {
    position: absolute;
    left: 0;
    top: 50%;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-style: italic;
    color: var(--text-muted);
    pointer-events: none;
    white-space: nowrap;
    transform: translateY(-50%);
    opacity: 1;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .terminal-input__hint--exit-up {
    transform: translateY(-150%);
    opacity: 0;
  }

  .terminal-input__hint--enter-below {
    transform: translateY(100%);
    opacity: 0;
    transition: none;
  }

  .terminal-input__autocomplete {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-style: italic;
    color: var(--text-muted);
    opacity: 0.5;
    pointer-events: none;
    white-space: nowrap;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Suggestion buttons */
  .terminal-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--terminal-border);
    margin-top: 0.75rem;
  }

  .terminal-suggestions__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    background: transparent;
    border: 1px solid var(--terminal-border);
    border-radius: var(--terminal-radius);
    color: var(--terminal-cyan);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 0.15s ease, text-shadow 0.15s ease, background-color 0.15s ease;
    min-height: 36px;
  }

  .terminal-suggestions__btn:hover,
  .terminal-suggestions__btn:focus-visible {
    border-color: var(--terminal-cyan);
    text-shadow: var(--glow-cyan);
    background: rgba(0, 255, 255, 0.05);
    outline: none;
  }

  .terminal-suggestions__btn:active {
    background: rgba(0, 255, 255, 0.1);
  }

  .terminal-suggestions__btn--secondary {
    border-style: dashed;
    color: var(--text-muted);
    font-size: 0.75rem;
    min-height: 30px;
    padding: 0.25rem 0.5rem;
  }

  .terminal-suggestions__btn--secondary:hover,
  .terminal-suggestions__btn--secondary:focus-visible {
    border-color: var(--terminal-amber);
    color: var(--terminal-amber);
    text-shadow: var(--glow-amber);
    background: rgba(255, 176, 0, 0.05);
  }

  .terminal-suggestions__btn--secondary .terminal-suggestions__prefix {
    color: var(--text-muted);
  }

  .terminal-suggestions__prefix {
    color: var(--terminal-green);
    font-weight: bold;
  }

  /* Section output styling */
  .terminal-section {
    margin: 0.5rem 0;
  }

  .terminal-section__header {
    color: var(--terminal-green);
    text-shadow: var(--glow-green);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--terminal-border);
    padding-bottom: 0.5rem;
  }

  .terminal-entry {
    margin-bottom: 1rem;
    padding-left: 0.5rem;
    border-left: 2px solid var(--terminal-border);
    padding-bottom: 0.25rem;
  }

  .terminal-entry--inline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-left: none;
    padding-left: 0;
  }

  .terminal-entry__title {
    font-weight: 700;
    font-size: 0.9375rem;
    margin-bottom: 0.125rem;
  }

  .terminal-entry__meta {
    font-size: 0.8125rem;
    margin-bottom: 0.375rem;
  }

  .terminal-entry__body {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .terminal-entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.375rem;
  }

  .terminal-pre {
    white-space: pre-wrap;
    word-break: break-word;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .site-terminal {
      padding: 0.5rem;
    }

    .site-terminal__window {
      min-height: calc(100vh - 1rem);
    }

    .terminal-about__ascii {
      font-size: 0.4rem;
    }

    .terminal-suggestions__btn {
      min-height: 44px;
      padding: 0.5rem 0.875rem;
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-input__cursor {
      animation: none;
      opacity: 1;
    }

    .terminal-suggestions__btn {
      transition: none;
    }
  }
</style>
