        <div class="terminal-about__links">
          <a href="https://linkedin.com/in/alihxn23" target="_blank" rel="noopener noreferrer" class="terminal-link" aria-label="LinkedIn Profile">
            [linkedin]
          </a>
          <a href="https://github.com/alihxn23" target="_blank" rel="noopener noreferrer" class="terminal-link" aria-label="GitHub Profile">
            [github]
          </a>
          <a href="mailto:alihxn23@gmail.com" class="terminal-link" aria-label="Email">
            [email]
          </a>
        </div>
      </div>

      <!-- Terminal output area where command results appear -->
      <div id="terminal-output"></div>

      <!-- Input prompt (always at bottom of content) -->
