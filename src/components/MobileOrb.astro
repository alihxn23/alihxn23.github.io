---
/**
 * MobileOrb.astro - Floating navigation orb for mobile
 *
 * A shiny glowing orb fixed at the bottom center of the viewport.
 * On tap, it expands into a radial/arc menu showing navigation commands.
 * Only visible on mobile (< 768px).
 */
import { COMMANDS } from '../scripts/terminal-nav.ts';

// Nav commands to show in the orb menu (exclude utility commands)
const navCommands = COMMANDS.filter(cmd => !["about", "help", "clear", "showall"].includes(cmd.name));
---

<!-- Backdrop overlay when menu is open -->
<div id="mobile-orb-overlay" class="mobile-orb-overlay" aria-hidden="true"></div>

<!-- Radial menu items -->
<nav id="mobile-orb-menu" class="mobile-orb-menu" aria-label="Navigation menu">
  {navCommands.map((cmd, i) => (
    <button
      class="mobile-orb-menu__item"
      data-orb-command={cmd.name}
      data-index={i}
      type="button"
      aria-label={`Navigate to ${cmd.name}`}
      style={`--item-index: ${i}; --item-total: ${navCommands.length};`}
    >
      <span class="mobile-orb-menu__label">{cmd.name}</span>
    </button>
  ))}
</nav>

<!-- The orb itself -->
<button
  id="mobile-orb"
  class="mobile-orb"
  type="button"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="mobile-orb-menu"
>
  <span class="mobile-orb__core"></span>
  <span class="mobile-orb__ring"></span>
  <span class="mobile-orb__pulse"></span>
</button>

<script>
  import { initMobileOrb } from '../scripts/mobile-orb.ts';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileOrb);
  } else {
    initMobileOrb();
  }
</script>

<style>
  /* Only show on mobile */
  .mobile-orb,
  .mobile-orb-menu,
  .mobile-orb-overlay {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-orb-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(10, 10, 15, 0.7);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 9990;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .mobile-orb-overlay--active {
      opacity: 1;
      pointer-events: auto;
    }

    /* --- The Orb --- */
    .mobile-orb {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      width: 56px;
      height: 56px;
      border-radius: 50%;
      border: none;
      background: transparent;
      z-index: 9995;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
    }

    .mobile-orb--open {
      transform: translateX(-50%) scale(0.85);
    }

    .mobile-orb--hidden {
      transform: translateX(-50%) translateY(80px);
      opacity: 0;
      pointer-events: none;
    }

    /* Inner glowing core */
    .mobile-orb__core {
      position: absolute;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: radial-gradient(
        circle at 40% 40%,
        #fffde6 0%,
        #e1ff29 35%,
        #c8e620 60%,
        #a0b800 100%
      );
      box-shadow:
        0 0 14px rgba(225, 255, 41, 0.9),
        0 0 28px rgba(225, 255, 41, 0.6),
        0 0 56px rgba(225, 255, 41, 0.3),
        inset 0 -2px 4px rgba(0, 0, 0, 0.2),
        inset 0 2px 4px rgba(255, 255, 255, 0.3);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      animation: orb-breathe 3s ease-in-out infinite;
    }

    .mobile-orb--open .mobile-orb__core {
      animation: none;
      box-shadow:
        0 0 18px rgba(225, 255, 41, 1),
        0 0 36px rgba(225, 255, 41, 0.8),
        0 0 72px rgba(225, 255, 41, 0.4),
        inset 0 -2px 4px rgba(0, 0, 0, 0.2),
        inset 0 2px 4px rgba(255, 255, 255, 0.4);
    }

    /* Outer ring */
    .mobile-orb__ring {
      position: absolute;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 1px solid rgba(225, 255, 41, 0.2);
      box-shadow: 0 0 4px rgba(225, 255, 41, 0.1);
      transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .mobile-orb--open .mobile-orb__ring {
      border-color: rgba(225, 255, 41, 0.4);
      transform: scale(1.1);
    }

    /* Pulsing aura */
    .mobile-orb__pulse {
      position: absolute;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: radial-gradient(
        circle,
        rgba(225, 255, 41, 0.2) 0%,
        rgba(225, 255, 41, 0) 70%
      );
      animation: orb-pulse 2.5s ease-in-out infinite;
    }

    .mobile-orb--open .mobile-orb__pulse {
      animation: none;
      opacity: 0;
    }

    @keyframes orb-pulse {
      0%, 100% {
        transform: scale(1);
        opacity: 0.6;
      }
      50% {
        transform: scale(1.3);
        opacity: 0;
      }
    }

    @keyframes orb-breathe {
      0%, 100% {
        transform: scale(1);
        box-shadow:
          0 0 14px rgba(225, 255, 41, 0.9),
          0 0 28px rgba(225, 255, 41, 0.6),
          0 0 56px rgba(225, 255, 41, 0.3),
          inset 0 -2px 4px rgba(0, 0, 0, 0.2),
          inset 0 2px 4px rgba(255, 255, 255, 0.3);
      }
      50% {
        transform: scale(1.06);
        box-shadow:
          0 0 18px rgba(225, 255, 41, 1),
          0 0 34px rgba(225, 255, 41, 0.7),
          0 0 60px rgba(225, 255, 41, 0.35),
          inset 0 -2px 4px rgba(0, 0, 0, 0.2),
          inset 0 2px 4px rgba(255, 255, 255, 0.3);
      }
    }

    /* --- Menu Items --- */
    .mobile-orb-menu {
      display: flex;
      position: fixed;
      bottom: 100px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 9993;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
      max-width: 320px;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .mobile-orb-menu--open {
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-orb-menu__item {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      background: rgba(18, 18, 26, 0.9);
      border: 1px solid rgba(0, 255, 65, 0.4);
      border-radius: 24px;
      color: var(--terminal-green);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition:
        transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 0.3s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
      transform: translateY(20px) scale(0.8);
      opacity: 0;
      box-shadow: 0 0 8px rgba(0, 255, 65, 0.2);
    }

    .mobile-orb-menu--open .mobile-orb-menu__item {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: calc(var(--item-index) * 0.05s);
    }

    .mobile-orb-menu__item:active {
      transform: scale(0.92);
      border-color: rgba(0, 255, 65, 0.8);
      box-shadow: 0 0 16px rgba(0, 255, 65, 0.5);
    }

    .mobile-orb-menu__label {
      text-shadow: 0 0 6px rgba(0, 255, 65, 0.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-orb__pulse {
      animation: none;
    }
    .mobile-orb__core {
      animation: none;
    }
    .mobile-orb-menu__item {
      transition: none;
    }
  }
</style>
