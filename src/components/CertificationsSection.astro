---
import profile from '../data/profile.json';

const { certifications } = profile;

const providerColors: Record<string, string> = {
  AWS: 'green',
  CompTIA: 'amber',
  ISC2: 'cyan',
  Udacity: 'green',
};
---

<section id="certifications" class="certifications" aria-label="Professional certifications">
  <div class="section-header">
    <span class="section-header__prefix">~/</span>
    <h2 class="section-header__title">certifications</h2>
    <span class="section-header__line"></span>
  </div>

  <div class="certifications__grid">
    {certifications.map((group) => {
      const color = providerColors[group.provider] || 'green';
      return (
        <div class={`terminal-window certifications__group certifications__group--${color}`}>
          <div class="terminal-window__title-bar">
            <div class="terminal-window__dots">
              <span class="terminal-window__dot terminal-window__dot--red"></span>
              <span class="terminal-window__dot terminal-window__dot--yellow"></span>
              <span class="terminal-window__dot terminal-window__dot--green"></span>
            </div>
            <span class="terminal-window__title">{group.provider}</span>
          </div>
          <div class="terminal-window__body">
            <ul class="certifications__list">
              {group.certifications.map((cert) => (
                <li class="certifications__item">
                  <span class={`terminal-tag terminal-tag--${color}`}>
                    {cert.code ? `${cert.name} (${cert.code})` : cert.name}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .certifications {
    padding: 4rem 1rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .certifications__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .certifications__group--green .terminal-window__title {
    color: var(--terminal-green);
    text-shadow: var(--glow-green);
  }

  .certifications__group--amber .terminal-window__title {
    color: var(--terminal-amber);
    text-shadow: var(--glow-amber);
  }

  .certifications__group--cyan .terminal-window__title {
    color: var(--terminal-cyan);
    text-shadow: var(--glow-cyan);
  }

  .certifications__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .certifications__item {
    display: inline-block;
  }

  @media (max-width: 480px) {
    .certifications {
      padding: 3rem 1rem;
    }
  }
</style>
