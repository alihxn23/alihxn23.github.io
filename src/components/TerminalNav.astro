---
/**
 * TerminalNav.astro - Interactive terminal navigation island
 *
 * Positioned inline directly below the hero section as the primary
 * navigation experience. Shows a command prompt with clickable
 * command suggestions that teach visitors the interaction pattern.
 *
 * On mobile, suggestions become the primary touch-friendly nav.
 * The terminal input remains accessible on all screen sizes.
 *
 * Hydrated with client:load since it's always visible and interactive.
 */

const commands = [
  { label: "experience", aliases: "exp, work" },
  { label: "skills", aliases: "tech, stack" },
  { label: "certs", aliases: "cert" },
  { label: "education", aliases: "edu" },
  { label: "contact", aliases: "social" },
  { label: "showall", aliases: "cat *, all" },
  { label: "help", aliases: "?" },
];
---

<nav class="terminal-nav" id="terminal-nav" aria-label="Terminal navigation">
  <div class="terminal-window terminal-nav__window">
    <div class="terminal-window__title-bar">
      <div class="terminal-window__dots">
        <span class="terminal-window__dot terminal-window__dot--red"></span>
        <span class="terminal-window__dot terminal-window__dot--yellow"></span>
        <span class="terminal-window__dot terminal-window__dot--green"></span>
      </div>
      <span class="terminal-window__title">visitor@hxn.sh:~ — navigation</span>
    </div>
    <div class="terminal-window__body terminal-nav__body">
      <div id="terminal-output" class="terminal-nav__output" role="log" aria-live="polite" aria-atomic="false" aria-label="Terminal command output">
        <div class="terminal-nav__welcome">
          <span class="text-secondary">Type a command or click a suggestion below to navigate.</span>
        </div>
      </div>
      <div class="terminal-nav__prompt terminal-prompt">
        <span class="terminal-prompt__user" aria-hidden="true">visitor@hxn.sh:~$</span>
        <div class="terminal-nav__input-wrapper">
          <input
            id="terminal-input"
            class="terminal-prompt__input"
            type="text"
            placeholder="type a command..."
            aria-label="Terminal command input. Type help for available commands."
            autocomplete="off"
            spellcheck="false"
          />
          <span class="terminal-nav__cursor" aria-hidden="true"></span>
        </div>
      </div>
      <div class="terminal-nav__suggestions" aria-label="Available commands">
        {commands.map((cmd) => (
          <button
            class="terminal-nav__suggestion"
            data-command={cmd.label}
            type="button"
            aria-label={`Run command: ${cmd.label}`}
          >
            <span class="terminal-nav__suggestion-prefix" aria-hidden="true">&gt;</span>
            {cmd.label}
          </button>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  import "../scripts/terminal-nav.ts";

  function initSuggestions() {
    const suggestions = document.querySelectorAll<HTMLButtonElement>(".terminal-nav__suggestion");
    const input = document.getElementById("terminal-input") as HTMLInputElement | null;

    if (!input) return;

    suggestions.forEach((btn) => {
      btn.addEventListener("click", () => {
        const command = btn.dataset.command || "";
        input.value = command;
        // Dispatch Enter keydown to trigger the terminal nav handler
        input.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
      });
    });
  }

  function initCursor() {
    const input = document.getElementById("terminal-input") as HTMLInputElement | null;
    const cursor = document.querySelector(".terminal-nav__cursor") as HTMLElement | null;

    if (!input || !cursor) return;

    // Create a hidden measurement span to calculate text width
    const measure = document.createElement("span");
    measure.setAttribute("aria-hidden", "true");
    // Apply styles inline since dynamically created elements won't get Astro scoped styles
    measure.style.position = "absolute";
    measure.style.top = "-9999px";
    measure.style.left = "-9999px";
    measure.style.whiteSpace = "pre";
    measure.style.font = getComputedStyle(input).font;
    measure.style.letterSpacing = getComputedStyle(input).letterSpacing;
    measure.style.visibility = "hidden";
    measure.style.pointerEvents = "none";
    document.body.appendChild(measure);

    function updateCursorPosition() {
      if (!input || !cursor || !measure) return;
      // Measure the width of text up to the caret position
      const textBeforeCaret = input.value.substring(0, input.selectionStart || 0);
      measure.textContent = textBeforeCaret || "";
      const offset = measure.offsetWidth;
      cursor.style.left = `${offset}px`;
    }

    // Update on every input change and caret movement
    input.addEventListener("input", updateCursorPosition);
    input.addEventListener("keyup", updateCursorPosition);
    input.addEventListener("click", updateCursorPosition);
    input.addEventListener("focus", () => {
      cursor.style.opacity = "1";
      updateCursorPosition();
    });
    input.addEventListener("blur", () => {
      // Reset cursor to start when not focused
      if (input.value === "") {
        cursor.style.left = "0px";
      }
    });

    // Initial position
    updateCursorPosition();
  }

  document.addEventListener("DOMContentLoaded", () => {
    initSuggestions();
    initCursor();
  });
</script>

<style>
  .terminal-nav {
    display: flex;
    justify-content: center;
    padding: 0 1rem 3rem;
    position: relative;
    z-index: 10;
  }

  .terminal-nav__window {
    max-width: 640px;
    width: 100%;
  }

  .terminal-nav__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .terminal-nav__output {
    overflow-y: auto;
    min-height: 0;
    max-height: 150px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .terminal-nav__welcome {
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .terminal-nav__prompt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .terminal-nav__input-wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .terminal-nav__input-wrapper .terminal-prompt__input {
    width: 100%;
    caret-color: transparent;
  }

  .terminal-nav__cursor {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0.55em;
    height: 1.2em;
    background: var(--terminal-green);
    animation: blink 1s step-end infinite;
    pointer-events: none;
    opacity: 1;
    transition: left 0.05s linear;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .terminal-nav__suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--terminal-border);
  }

  .terminal-nav__suggestion {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    background: transparent;
    border: 1px solid var(--terminal-border);
    border-radius: var(--terminal-radius);
    color: var(--terminal-cyan);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 0.15s ease, text-shadow 0.15s ease, background-color 0.15s ease;
    min-height: 36px;
  }

  .terminal-nav__suggestion:hover,
  .terminal-nav__suggestion:focus-visible {
    border-color: var(--terminal-cyan);
    text-shadow: var(--glow-cyan);
    background: rgba(0, 255, 255, 0.05);
    outline: none;
  }

  .terminal-nav__suggestion:active {
    background: rgba(0, 255, 255, 0.1);
  }

  .terminal-nav__suggestion-prefix {
    color: var(--terminal-green);
    font-weight: bold;
  }

  /* Mobile (320px - 767px) */
  @media (max-width: 767px) {
    .terminal-nav {
      padding: 0 0.75rem 2rem;
    }

    .terminal-nav__window {
      max-width: 100%;
    }

    .terminal-nav__suggestions {
      gap: 0.5rem;
    }

    .terminal-nav__suggestion {
      min-height: 44px;
      padding: 0.5rem 0.875rem;
      font-size: 0.875rem;
    }

    .terminal-nav__output {
      max-height: 80px;
      font-size: 0.75rem;
    }
  }

  /* Tablet (768px - 1023px) */
  @media (min-width: 768px) and (max-width: 1023px) {
    .terminal-nav__window {
      max-width: 580px;
    }

    .terminal-nav__output {
      max-height: 120px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-nav__suggestion {
      transition: none;
    }

    .terminal-nav__cursor {
      animation: none;
      opacity: 1;
    }
  }
</style>
