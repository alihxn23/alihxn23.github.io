---
/**
 * TerminalNav.astro - Interactive terminal navigation island
 *
 * Fixed-position terminal window at the bottom of the viewport.
 * Provides a command prompt for navigating between sections,
 * with clickable nav links as fallback for traditional navigation.
 *
 * On mobile (< 768px), touch-friendly nav links are the primary
 * navigation method with larger touch targets (min 44x44px).
 * A toggle button allows showing/hiding the terminal input on mobile.
 *
 * Hydrated with client:load since it's always visible and interactive.
 */

const navLinks = [
  { label: "about", href: "#hero" },
  { label: "experience", href: "#experience" },
  { label: "skills", href: "#skills" },
  { label: "certs", href: "#certifications" },
  { label: "education", href: "#education" },
  { label: "contact", href: "#contact" },
];
---

<nav class="terminal-nav" aria-label="Terminal navigation">
  <div class="terminal-window terminal-nav__window">
    <div class="terminal-window__title-bar">
      <div class="terminal-window__dots">
        <span class="terminal-window__dot terminal-window__dot--red"></span>
        <span class="terminal-window__dot terminal-window__dot--yellow"></span>
        <span class="terminal-window__dot terminal-window__dot--green"></span>
      </div>
      <span class="terminal-window__title">visitor@hxn.sh:~</span>
      <button
        id="terminal-toggle"
        class="terminal-nav__toggle"
        aria-label="Toggle terminal input"
        aria-expanded="false"
      >
        <span class="terminal-nav__toggle-icon" aria-hidden="true">&#9776;</span>
      </button>
    </div>
    <div class="terminal-window__body terminal-nav__body">
      <div class="terminal-nav__links">
        {navLinks.map((link) => (
          <a href={link.href} class="terminal-link terminal-nav__link">{link.label}</a>
        ))}
      </div>
      <div id="terminal-input-section" class="terminal-nav__input-section">
        <div id="terminal-output" class="terminal-nav__output" aria-live="polite" aria-atomic="false"></div>
        <div class="terminal-nav__prompt terminal-prompt">
          <span class="terminal-prompt__user" aria-hidden="true">visitor@hxn.sh:~$</span>
          <input
            id="terminal-input"
            class="terminal-prompt__input"
            type="text"
            aria-label="Terminal command input. Type help for available commands."
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  import "../scripts/terminal-nav.ts";

  // Mobile terminal toggle functionality
  function initTerminalToggle() {
    const toggleBtn = document.getElementById("terminal-toggle");
    const inputSection = document.getElementById("terminal-input-section");

    if (!toggleBtn || !inputSection) return;

    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", String(!isExpanded));
      inputSection.classList.toggle("terminal-nav__input-section--visible");

      // Update toggle icon
      const icon = toggleBtn.querySelector(".terminal-nav__toggle-icon");
      if (icon) {
        icon.textContent = !isExpanded ? "\u2715" : "\u2630";
      }

      // Focus the input when expanded
      if (!isExpanded) {
        const input = document.getElementById("terminal-input") as HTMLInputElement;
        if (input) input.focus();
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initTerminalToggle);
</script>

<style>
  .terminal-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0 1rem 1rem;
    pointer-events: none;
  }

  .terminal-nav__window {
    max-width: 640px;
    margin: 0 auto;
    pointer-events: auto;
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.6);
  }

  .terminal-nav__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 200px;
  }

  .terminal-nav__output {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    max-height: 120px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .terminal-nav__prompt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .terminal-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--terminal-border);
    font-size: 0.75rem;
  }

  .terminal-nav__link {
    padding: 0.125rem 0.375rem;
  }

  /* Toggle button - hidden on desktop, visible on mobile */
  .terminal-nav__toggle {
    display: none;
    background: none;
    border: 1px solid var(--terminal-border);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 1.125rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    line-height: 1;
    margin-left: auto;
    min-width: 44px;
    min-height: 32px;
    align-items: center;
    justify-content: center;
  }

  .terminal-nav__toggle:hover,
  .terminal-nav__toggle:focus-visible {
    background: var(--terminal-border);
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  /* Input section - visible by default on desktop */
  .terminal-nav__input-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Ensure the terminal input is visible and usable */
  #terminal-input {
    min-width: 0;
  }

  /* Mobile (320px - 767px) */
  @media (max-width: 767px) {
    .terminal-nav {
      padding: 0 0.5rem 0.5rem;
    }

    .terminal-nav__window {
      max-width: 100%;
      border-radius: var(--terminal-radius) var(--terminal-radius) 0 0;
    }

    .terminal-nav__body {
      max-height: none;
      padding: 0.5rem;
    }

    /* Toggle button visible on mobile */
    .terminal-nav__toggle {
      display: inline-flex;
    }

    /* Nav links: primary navigation on mobile with touch-friendly targets */
    .terminal-nav__links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-top: 0.5rem;
      border-top: none;
      border-bottom: 1px solid var(--terminal-border);
      padding-bottom: 0.5rem;
      font-size: 0.875rem;
    }

    .terminal-nav__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--terminal-border);
      border-radius: 4px;
      text-decoration: none;
      font-size: 0.875rem;
      transition: background-color 0.15s ease;
    }

    .terminal-nav__link:hover,
    .terminal-nav__link:active {
      background: var(--terminal-border);
    }

    /* Terminal input section hidden by default on mobile */
    .terminal-nav__input-section {
      display: none;
    }

    .terminal-nav__input-section--visible {
      display: flex;
    }

    .terminal-nav__output {
      max-height: 60px;
      font-size: 0.75rem;
    }
  }

  /* Tablet (768px - 1023px) */
  @media (min-width: 768px) and (max-width: 1023px) {
    .terminal-nav {
      padding: 0 1rem 0.75rem;
    }

    .terminal-nav__window {
      max-width: 560px;
    }

    .terminal-nav__body {
      max-height: 170px;
    }

    .terminal-nav__output {
      max-height: 90px;
      font-size: 0.8125rem;
    }
  }
</style>
